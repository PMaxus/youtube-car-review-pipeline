# Names of the secrets to configure. No values here.
# In the self-hosted n8n setup these live in n8n's encrypted credential store,
# separated from the workflow logic. This file is only a map of what is needed.

# Telegram
TELEGRAM_BOT_TOKEN=
OPERATOR_CHAT_ID=

# LLM / transcripts / voice
OPENROUTER_API_KEY=
OPENAI_API_KEY=
SCRAPECREATORS_API_KEY=
INWORLD_API_KEY=

# YouTube Data API (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
